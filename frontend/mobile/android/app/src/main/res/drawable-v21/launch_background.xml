<?xml version="1.0" encoding="utf-8"?>
<!-- Écran de lancement (Android 7 à 11) : fond navy et logo ElecPay au centre (88 dp, comme le
     carré du Splash Flutter). Logo généré par tool/launcher/generate_launcher_images_test.dart. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/elecpay_navy" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
