APP_ENV=development
DATABASE_URL=mysql+pymysql://elecpay:elecpay@127.0.0.1:3307/elecpay?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://elecpay:elecpay@127.0.0.1:3307/elecpay_test?charset=utf8mb4
# Secret de signature des jetons : 32 caractères aléatoires minimum (64 conseillés). Générer avec :
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Cookies du back-office en HTTPS uniquement (obligatoire en production ; localhost est accepté
# par les navigateurs même en HTTP). Mettre false seulement pour un test en HTTP hors localhost.
AUTH_COOKIE_SECURE=true
PAYMENT_PROVIDER=simulated
# Secret de signature des webhooks de paiement (HMAC) : 32 caractères aléatoires minimum, même
# commande que JWT_SECRET. Vide : tous les webhooks sont refusés.
PAYMENT_WEBHOOK_SECRET=
# Sans saisie du code PIN dans ce délai (minutes), la transaction expire
PAYMENT_TIMEOUT_MINUTES=10
# Reçus : adresse de la vérification publique imprimée dans le QR code (https en production)
RECEIPT_VERIFY_URL=http://127.0.0.1:8000/api/v1/receipts/verify
BILLING_SOURCE=simulated
DEMO_MODE=true
# Facturation : période en mois (1, 2, 3, 4, 6 ou 12), délais d'émission et d'échéance en jours
BILLING_PERIOD_MONTHS=2
BILL_ISSUE_DELAY_DAYS=3
BILL_DUE_DELAY_DAYS=15
# Origines autorisées à appeler l'API depuis un navigateur (back-office), séparées par des virgules
CORS_ORIGINS=http://localhost:3000
