APP_ENV=development
DATABASE_URL=mysql+pymysql://elecpay:elecpay@127.0.0.1:3307/elecpay?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://elecpay:elecpay@127.0.0.1:3307/elecpay_test?charset=utf8mb4
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PAYMENT_PROVIDER=simulated
BILLING_SOURCE=simulated
DEMO_MODE=true
# Facturation : période en mois (1, 2, 3, 4, 6 ou 12), délais d'émission et d'échéance en jours
BILLING_PERIOD_MONTHS=2
BILL_ISSUE_DELAY_DAYS=3
BILL_DUE_DELAY_DAYS=15
# Origines autorisées à appeler l'API depuis un navigateur (back-office), séparées par des virgules
CORS_ORIGINS=http://localhost:3000
