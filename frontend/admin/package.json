{
  "name": "elecpay-admin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Back-office d'administration ElecPay (Next.js) : voir PLAN.md",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node tool/vitest.ts run",
    "test:watch": "node tool/vitest.ts",
    "generate:tokens": "node tool/generate-tokens.ts",
    "generate:api": "node tool/generate-api-types.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.108.4",
    "lucide-react": "1.81.0",
    "next": "16.4.6",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.4",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "jsdom": "29.0.2",
    "openapi-typescript": "7.13.0",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.1.2"
  }
}
