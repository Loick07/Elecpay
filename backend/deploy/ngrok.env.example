# Configuration de l'API ElecPay exposée par ngrok (étape M1), sur le PC de Loick.
# NE PAS REMPLIR À LA MAIN : `.\deploy\public.ps1 -Step preparer` copie ce modèle dans
# `deploy\ngrok.env` (ignoré par git) et y écrit des secrets tirés au hasard sur CE PC.
# Les secrets ne passent jamais par le dépôt, ni par une conversation. Guide : docs/DEPLOIEMENT.md.

# --- Mode -------------------------------------------------------------------------------------
# production : tous les garde-fous de sécurité sont imposés au démarrage (secrets forts, cookies
# sécurisés, CORS en https, 2FA de l'équipe obligatoire).
APP_ENV=production
# Données simulées (paiements, relevés E²C) : DEMO_MODE=true est obligatoire (badge « Mode démo »).
PAYMENT_PROVIDER=simulated
BILLING_SOURCE=simulated
DEMO_MODE=true

# --- Base dédiée à l'API publique (jamais elecpay, elecpay_test ni elecpay_e2e) ---------------
# Utilisateur MySQL propre à cette base, mot de passe tiré au hasard par `preparer`.
DATABASE_URL=

# --- Secrets (tirés au hasard par `preparer`, jamais dans le dépôt) ---------------------------
JWT_SECRET=
TWO_FACTOR_KEY=
PAYMENT_WEBHOOK_SECRET=
# Mot de passe commun des comptes de démo (scripts.seed) : jamais « Demo2026! ». À lire dans
# deploy\ngrok.env pour se connecter à l'application.
DEMO_SEED_PASSWORD=

# --- ngrok : domaine fixe gratuit de Loick ----------------------------------------------------
# Adresse imprimée dans le QR code des reçus.
RECEIPT_VERIFY_URL=https://omnivore-pardon-sixth.ngrok-free.dev/api/v1/receipts/verify
# Seule origine autorisée pour un navigateur (le back-office web ajoutera la sienne).
CORS_ORIGINS=https://omnivore-pardon-sixth.ngrok-free.dev
# L'agent ngrok se connecte depuis CE PC : seulement depuis lui, l'IP réelle du client est lue
# dans X-Forwarded-For (limites de tentatives et journal justes, personne ne peut choisir son IP).
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- Valeurs imposées en production -----------------------------------------------------------
AUTH_COOKIE_SECURE=true
TEAM_2FA_REQUIRED=true
RATE_LIMIT_PER_MINUTE=300
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Délais (valeurs de l'API) -----------------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
PAYMENT_TIMEOUT_MINUTES=10
BILLING_PERIOD_MONTHS=2
BILL_ISSUE_DELAY_DAYS=3
BILL_DUE_DELAY_DAYS=15
